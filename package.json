{
  "name": "neo-studio-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "npm run dev & npm run dev:api",
    "build": "tsc -b && node scripts/sync-msa.mjs && node scripts/generate-seo-assets.mjs && vite build && tsx scripts/prerender.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start": "cross-env SERVE_DIST=1 tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.3",
    "hono": "^4.7.10",
    "lenis": "^1.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  }
}
